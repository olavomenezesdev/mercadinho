# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA envie o arquivo ".env" para o GitHub.

# Supabase: Project Settings -> API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-chave-do-supabase

# Chave que assina os tokens de login (texto longo e aleatório).
# Para gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio

# Opcional: em quantos dias antes do vencimento o sistema avisa "validade próxima" (padrão: 30).
# DIAS_VALIDADE_PROXIMA=30

# Opcional: origens liberadas para chamar a API de outro endereço (separadas por vírgula).
# ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
